# @meddleware/treasury-ui — build-time environment
# Copy to .env.local for local dev (never commit .env.local).
# In production these are Docker --build-arg values baked into the static bundle.

# Network the standalone build selects: testnet (default) or mainnet. Embedded views follow the
# host's network selector.
VITE_NETWORK=testnet

# The access_gate ids come from @meddleware/access-gate-client/deployments for the active network.

# Optional read-indexer (display data; reads fall back to the full node after 3 s).
# VITE_INDEXER_URL=https://sui-indexer.meddleware.co.uk

# Documentation URL — override to link to a custom or staging docs deployment.
# VITE_DOCS_URL=https://docs.meddleware.co.uk/blockchain/sui/treasury/

# Developer docs URL — override to link to a custom or staging dev-docs deployment.
# VITE_DEV_URL=https://dev.meddleware.co.uk/sui/treasury/
