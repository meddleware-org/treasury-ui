# @meddleware/treasury-ui — build-time environment
# Copy to .env.local for local dev (never commit .env.local).
# In production these are Docker --build-arg values baked into the static bundle.

# Network the build targets: testnet (default) or mainnet.
VITE_NETWORK=testnet

# Sui gRPC-web RPC overrides (public fullnodes are the built-in defaults).
# VITE_RPC_TESTNET=https://fullnode.testnet.sui.io:443
# VITE_RPC_MAINNET=https://fullnode.mainnet.sui.io:443

# access_gate deployment read by this dashboard. Testnet defaults to Meddleware's canonical
# deployment (package 0x1a81ca… / PlatformConfig 0xe3b949…); mainnet has no default yet.
# VITE_ACCESS_GATE_PACKAGE_ID_TESTNET=0x1a81ca177db039585e575beeeee4759466e55910e936a6733e38dbb65025eea4
# VITE_PLATFORM_CONFIG_ID_TESTNET=0xe3b949cabe9a0574c03dfc924fb3f96e6f959f2bb86d053ed6229a241c3a23f7
# VITE_ACCESS_GATE_PACKAGE_ID_MAINNET=
# VITE_PLATFORM_CONFIG_ID_MAINNET=

# Documentation URL — override to link to a custom or staging docs deployment.
# VITE_DOCS_URL=https://docs.meddleware.co.uk/blockchain/sui/treasury/

# Developer docs URL — override to link to a custom or staging dev-docs deployment.
# VITE_DEV_URL=https://dev.meddleware.co.uk/sui/treasury/
