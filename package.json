{
  "name": "@meddleware/treasury-ui",
  "version": "0.0.1",
  "homepage": "https://docs.meddleware.co.uk/treasury/",
  "description": "Meddleware treasury console — organisation-level accounting across revenue streams (Sui and beyond). Read-only, desktop-console UI built on @meddleware/ui.",
  "author": "Meddleware <dev@meddleware.co.uk>",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/treasury-ui.git"
  },
  "type": "module",
  "files": [
    "src",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@meddleware/design-tokens": "^0.1.6",
    "@meddleware/ui": "^0.1.27",
    "@meddleware/wallet-adapter": "^0.0.8",
    "@mysten/sui": "^2.33.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "~24.12.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.0",
    "vite": "^8.3.0",
    "vitest": "~5.0.1",
    "vue-tsc": "~3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
