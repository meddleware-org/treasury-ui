{
  "name": "@meddleware/treasury-ui",
  "version": "0.0.2",
  "homepage": "https://docs.meddleware.co.uk/treasury/",
  "description": "Meddleware treasury console — organisation-level accounting across revenue streams (Sui and beyond). Read-only, desktop-console UI built on @meddleware/ui.",
  "author": "Meddleware <dev@meddleware.co.uk>",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/treasury-ui.git"
  },
  "type": "module",
  "files": [
    "src",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "lint:js": "eslint .",
    "lint": "npm run lint:css && npm run lint:js && npm run lint:html",
    "lint:html": "html-validate \"src/**/*.vue\""
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@meddleware/design-tokens": "^0.1.7",
    "@meddleware/ui": "^0.1.28",
    "@meddleware/wallet-adapter": "^0.0.9",
    "@mysten/sui": "^2.33.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "~24.12.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "html-validate": "^11.16.1",
    "html-validate-vue": "^9.3.1",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.0",
    "vitest": "~5.0.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "~3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
